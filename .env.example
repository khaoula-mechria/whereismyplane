# Copier en .env (ignoré par git). Ne jamais mettre de vraies valeurs ici.
# Aucune variable n'est requise pour le travail local (WP0-WP4).

# AWS : région retenue (ADR-0011). Les identifiants viennent du profil AWS ou d'OIDC, jamais de ce fichier.
AWS_REGION=us-east-1

# Modèle Bedrock : NON CHOISI (ADR-0012). À renseigner après vérification en us-east-1.
BEDROCK_MODEL_ID=
